# Copy to .env and add local credentials. Never commit .env.
# Only the variables needed by a chosen provider must be populated.

# OpenAI-compatible hosted providers
OPENAI_API_KEY=
OPENAI_API_KEY_ALT=
OPENROUTER_API_KEY=

# Optional future direct Anthropic adapter
ANTHROPIC_API_KEY=

# Optional live scientific-tool integrations
OPENLCA_IPC_URL=http://localhost:8080

# Local output override
RESULTS_DIR=results/raw
